    def apply_palette(self):
        button_styles = [
            (self.btn_chat, "sky_blue", "sky_blue_hover"),
            (self.btn_breath, "lavender", "lavender_hover"),
            (self.btn_sounds, "soft_yellow", "soft_yellow_hover"),
            (self.btn_journal, "pink", "pink_hover"),
            (self.chat_back_btn, "sky_blue", "sky_blue_hover"),
            (self.chat_send_btn, "peach", "peach_hover"),
            (self.breath_back_btn, "sky_blue", "sky_blue_hover"),
            (self.breath_start_btn, "lavender", "lavender_hover"),
            (self.sounds_back_btn, "sky_blue", "sky_blue_hover"),
            (self.journal_back_btn, "sky_blue", "sky_blue_hover"),
            (self.unlock_btn, "pink", "pink_hover"),
            (self.save_note_btn, "sky_blue", "sky_blue_hover"),
            (self.burn_note_btn, "peach", "peach_hover"),
            (self.quick_calm_btn, "peach", "peach_hover"),
            (self.wellness_btn, "lavender", "lavender_hover"),
            (self.wellness_back_btn, "sky_blue", "sky_blue_hover"),
            (self.recommend_btn, "soft_yellow", "soft_yellow_hover"),
            (self.add_goal_btn, "sky_blue", "sky_blue_hover"),
            (self.complete_goal_btn, "pink", "pink_hover"),
        ]
        for button, color, hover_color in button_styles:
            button.configure(
                fg_color=COLORS[color],
                hover_color=COLORS[hover_color],
                text_color=COLORS["ink"],
            )

        sound_colors = [
            ("sky_blue", "sky_blue_hover"),
            ("lavender", "lavender_hover"),
            ("soft_yellow", "soft_yellow_hover"),
            ("peach", "peach_hover"),
        ]
        for button, (color, hover_color) in zip(self.sound_buttons, sound_colors):
            button.configure(
                fg_color=COLORS[color],
                hover_color=COLORS[hover_color],
                text_color=COLORS["ink"],
            )
        for button, (color, hover_color) in zip(self.playlist_buttons, sound_colors):
            button.configure(
                fg_color=COLORS[color],
                hover_color=COLORS[hover_color],
                text_color=COLORS["ink"],
            )

        self.lang_menu.configure(
            fg_color=COLORS["paper"],
            button_color=COLORS["sky_blue"],
            button_hover_color=COLORS["sky_blue_hover"],
            text_color=COLORS["ink"],
        )
        self.lbl_welcome.configure(text_color=COLORS["ink"])
        self.lbl_quote.configure(text_color=COLORS["ink"])
        self.breath_instruction.configure(text_color=COLORS["ink"])
        self.chat_disclaimer.configure(text_color=COLORS["ink"])
        self.wellness_title.configure(text_color=COLORS["ink"])
        self.wellness_subtitle.configure(text_color=COLORS["ink"])
        self.chat_text.configure(fg_color=COLORS["paper"], text_color=COLORS["ink"])
        self.note_content.configure(fg_color=COLORS["paper"], text_color=COLORS["ink"])
        self.notes_box.configure(fg_color=COLORS["paper"], text_color=COLORS["ink"])
        self.goals_box.configure(fg_color=COLORS["paper"], text_color=COLORS["ink"])

