    def recommend_wellness(self):
        mood = self.mood_menu.get().lower()
        activity = self.activity_menu.get().lower()
        suggestions = {
            "anxious": "Try box breathing for two minutes, then name five things you can see. You do not have to solve everything at once.",
            "low": "Choose a soft reset: drink water, step into fresh air, or write one kind sentence to yourself.",
            "tired": "Pick Ocean Sleep or Guided Relaxation. Lower the lights and let rest be productive enough.",
            "unfocused": "Try a 5-minute Soft Study playlist and one small task with your phone out of reach.",
            "calm": "Protect this calm with a mindful stretch or a short journal note about what is helping.",
        }
        activity_hint = {
            "relax": " A slow exhale can help your body shift into rest.",
            "focus": " Keep the next step small and time-box it for five minutes.",
            "sleep": " Make the room comfortable and avoid pressuring yourself to fall asleep immediately.",
            "reset": " A change of posture and a sip of water can be a useful first step.",
        }
        self.recommendation_label.configure(text=suggestions.get(mood, suggestions["calm"]) + activity_hint.get(activity, ""))

    def add_goal(self):
        goal = self.goal_entry.get().strip()
        if not goal:
            return
        self.daily_goals.append({"text": goal, "complete": False})
        self.goal_entry.delete(0, "end")
        self.refresh_goals()

    def complete_goal(self):
        for goal in self.daily_goals:
            if not goal["complete"]:
                goal["complete"] = True
                self.completed_goals += 1
                self.streak = max(self.streak, self.completed_goals)
                break
        self.refresh_goals()

    def refresh_goals(self):
        self.goals_box.configure(state="normal")
        self.goals_box.delete("1.0", "end")
        if not self.daily_goals:
            self.goals_box.insert("end", "Add one small goal for today.")
        else:
            for goal in self.daily_goals:
                marker = "✓" if goal["complete"] else "○"
                self.goals_box.insert("end", f"{marker} {goal['text']}\n")
        self.goals_box.configure(state="disabled")
        self.streak_label.configure(text=f"🌱 {self.streak}-day streak - gentle consistency counts")

    def start_box_breathing(self):
        self.breath_sequence = [("inhale", 4), ("hold", 4), ("exhale", 4), ("hold", 4)]
        self.breath_step = 0
        self.breath_cycle()

